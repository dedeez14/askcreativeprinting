VITE_API_BASE=https://your-erp-domain.tld/api/landing/v1

# Analytics (optional) — leave blank to disable. No tag loads unless an ID is set.
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID, e.g. 123456789012345
VITE_META_PIXEL_ID=

# Stage 4 ERP contract (06 B3/B4/B5/B6-B9/B10/B15) — OFF by default.
# 1 = send the complete B4 enquiry to POST /enquiries, the design tool to
#     POST /design-submissions, and read customer tracking from GET /p/job-status/{token}.
# Only turn this on once the ERP deployment serves those endpoints.
VITE_ENQUIRY_V2=0
